    ".": "./src/crowdfunding.mjs",
    "./journal": "./src/journal.mjs",
    "./load-campaign-data": "./scripts/load-campaign-data.mjs",
    "./validate-campaign": "./scripts/validate-campaign.mjs",
    "./compute-goal": "./scripts/compute-goal.mjs",
    "./render-campaign-page": "./scripts/render-campaign-page.mjs",
    "./campaign-readiness": "./scripts/campaign-readiness.mjs",
    "./record-pledge": "./scripts/record-pledge.mjs"
  },
  "bin": {
    "crowdfunding": "apps/crowdfunding-cli.mjs"
  },
  "files": [
    "src",
    "scripts",
    "apps"
  ],
  "dependencies": {
    "@red-cup-engineering/node-js-function-engineering-services-section": "^0.5.1",
